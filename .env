# Credenciales de Supabase — ver .env.example para las instrucciones completas.
#
# Panel de Supabase → tu proyecto → Project Settings → API
#   Project URL        →  VITE_SUPABASE_URL
#   anon / public key  →  VITE_SUPABASE_ANON_KEY
#
# Mientras estén vacías, la app arranca y muestra un aviso rojo en pantalla.
# Tras rellenarlas, reinicia `npm run dev`.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
