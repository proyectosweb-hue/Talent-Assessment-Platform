# ============================================================================
#  Credenciales de Supabase
# ----------------------------------------------------------------------------
#  Este archivo es OPCIONAL: si no existe, la app usa las credenciales por
#  defecto que trae `src/supabase.ts` y conecta igual.
#
#  Sirve para apuntar la app a OTRO proyecto de Supabase sin tocar código.
#  Cópialo como `.env` (en la raíz) y rellena los dos valores. Los encuentras
#  en el panel de Supabase de tu proyecto:
#
#      https://supabase.com/dashboard  →  tu proyecto
#      →  Project Settings  →  API
#
#      Project URL   ......  VITE_SUPABASE_URL
#      anon / public key ..  VITE_SUPABASE_ANON_KEY
#
#  Después de cambiar el .env hay que reiniciar `npm run dev` — Vite solo lee
#  estas variables al arrancar.
#
#  ⚠️  Aquí va SOLO la clave `anon` (es pública, viaja en el navegador y está
#      protegida por las políticas RLS). NUNCA pongas la `service_role` key en
#      este archivo: daría acceso total a la base de datos desde el navegador.
# ============================================================================

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY
